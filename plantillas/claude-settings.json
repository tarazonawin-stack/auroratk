    "ask": [
      "Bash(git push:*)",
      "Bash(git merge:*)",
      "Bash(uv add:*)",
      "Bash(pip install:*)",
      "Bash(npm install:*)",
      "Bash(docker compose down:*)"
    ]
  }
}
